---
interface Props { number: string; title: string; description: string; }
const { number, title, description } = Astro.props;
---
<article class="card bg-base-200 border-base-300 border shadow-sm">
  <div class="card-body gap-5">
    <span class="badge badge-primary badge-soft badge-lg text-base-content font-mono">{number}</span>
    <div><h3 class="card-title mb-2 text-2xl">{title}</h3><p class="m-0 leading-relaxed">{description}</p></div>
  </div>
</article>
