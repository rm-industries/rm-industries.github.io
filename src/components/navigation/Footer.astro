---
import { site } from '../../config/site';
import { isExternalHref } from '../../lib/navigation';
import { resolveSiteHref } from '../../lib/paths';
import Container from '../ui/Container.astro';
---

<footer class="border-base-content/10 bg-base-200 border-t">
  <Container class="footer footer-horizontal py-12">
    <aside>
      <a href={resolveSiteHref('/')} class="text-base-content inline-flex items-center gap-3 font-bold tracking-tight no-underline">
        <img src={resolveSiteHref('/logo.svg')} width="48" height="32" alt="" />
        <h2>{site.name}</h2>
      </a>
      <p class="max-w-sm">{site.description}</p>
      <p>© {new Date().getFullYear()} {site.name}</p>
    </aside>

    {
      site.socialLinks.length > 0 && (
        <nav aria-label="Social links">
          <h2>Elsewhere</h2>
          {site.socialLinks.map((item) => (
            <a
              href={resolveSiteHref(item.href)}
              class="link link-hover"
              target={isExternalHref(item.href) ? '_blank' : undefined}
              rel={isExternalHref(item.href) ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
  </Container>
</footer>
