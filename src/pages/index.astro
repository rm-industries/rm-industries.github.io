---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { resolveSiteHref } from '../lib/paths';
---

<BaseLayout>
  <Container class="pb-20">
    <section class="py-24 sm:py-32 lg:py-44" aria-labelledby="company-heading">
      <div class="text-primary mb-6 font-mono text-base font-semibold tracking-[0.12em] uppercase sm:text-lg">Independent software company</div>
      <div class="grid items-end gap-12 md:grid-cols-[minmax(0,1.65fr)_minmax(18rem,0.7fr)]">
        <h1 id="company-heading" class="m-0 max-w-[13ch] text-[clamp(3.25rem,8.4vw,7rem)] leading-[0.95] font-bold tracking-[-0.065em]">Useful software starts with a real problem.</h1>
        <div class="max-w-md pb-2">
          <p class="mb-8 text-[clamp(1.125rem,2.4vw,1.4rem)] leading-relaxed">RM Industries finds friction in everyday work and builds focused software to remove it.</p>
          <a href="#work" class="link text-base-content inline-flex items-center gap-2 font-semibold decoration-2 underline-offset-[0.35rem]">See what we’re building <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section id="work" class="border-base-content/10 border-t py-16 sm:py-24 lg:py-28" aria-labelledby="work-heading">
      <div class="mb-12 grid gap-6 md:grid-cols-[1fr_0.7fr] md:items-end">
        <div>
          <p class="text-primary mb-6 font-mono text-base font-semibold tracking-[0.12em] uppercase sm:text-lg">Current work</p>
          <h2 id="work-heading" class="m-0 max-w-[15ch] text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] font-bold tracking-[-0.045em]">One project, built with care.</h2>
        </div>
        <p class="text-base-content/70 m-0 max-w-lg text-lg leading-relaxed">We share products once they are far enough along to be genuinely useful.</p>
      </div>

      <article class="card border-base-content/10 bg-base-200 overflow-hidden border">
        <div class="card-body grid gap-8 p-6 sm:p-10 md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-center lg:p-14">
          <div class="font-mono text-xs tracking-[0.12em] uppercase" aria-hidden="true">01</div>
          <div>
            <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs tracking-[0.12em] uppercase"><span>Open source</span><span>Developer tooling</span></div>
            <h3 class="my-4 text-[clamp(3rem,7vw,5.5rem)] leading-none tracking-[-0.055em]">Forge</h3>
            <p class="mb-8 max-w-2xl text-lg leading-relaxed">An opinionated Astro starter for modern websites with beautiful defaults, Git-backed content management, and production-ready GitHub automation.</p>
            <a href="https://github.com/rm-industries/forge" class="link text-base-content inline-flex items-center gap-2 font-semibold decoration-2 underline-offset-[0.35rem]" target="_blank" rel="noopener noreferrer">
            Explore Forge on GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="border-primary/30 bg-base-100 grid aspect-square w-full max-w-56 place-items-center justify-self-end rounded-[1.75rem] border p-8 shadow-sm" aria-hidden="true">
            <img src={resolveSiteHref('/forge-logo.svg')} width="160" height="160" alt="" />
          </div>
        </div>
      </article>
    </section>

    <section class="pt-16 pb-12 sm:pt-24 lg:pt-32" aria-labelledby="contact-heading">
      <p class="text-primary mb-6 font-mono text-xs font-medium tracking-[0.16em] uppercase">Stay in touch</p>
      <h2 id="contact-heading" class="m-0 max-w-[15ch] text-[clamp(2.25rem,5vw,4rem)] leading-[1.05] font-bold tracking-[-0.045em]">Follow the work as it takes shape.</h2>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
        <a class="link text-base-content font-semibold underline-offset-4" href="https://github.com/rm-industries" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a class="link text-base-content font-semibold underline-offset-4" href="mailto:rahul@rm-industries.com">rahul@rm-industries.com <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </Container>
</BaseLayout>
